{
  "name": "hmp-expeditions",
  "version": "0.12.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Cooperative expeditions: a party fights through stages to a final foe, built in game, with experience rewards and clear-time records, built on HMP Foundations.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": ["dist/server.js"],
    "clientScripts": ["dist/client.js"],
    "files": ["dist/client.js", "dist/hud.html"],
    "resourceDependencies": [
      { "name": "hmp-lib", "version": "0.12.0" },
      { "name": "hmp-core", "version": "0.12.0" },
      { "name": "hmp-activities", "version": "0.12.0" },
      { "name": "hmp-worldstate", "version": "0.12.0" },
      { "name": "hmp-npcs", "version": "0.12.0" },
      { "name": "hmp-progression", "version": "0.12.0" }
    ],
    "errorBehavior": "stop",
    "priority": -300
  }
}
